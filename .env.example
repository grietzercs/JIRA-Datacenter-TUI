# Copy to .env (gitignored) and fill in. `make run` passes it via --env-file.
# Values here are placeholders, not real credentials.
JIRA_URL=https://jira.example.com
# bearer (personal access token, Jira DC 8.14+) or basic (username + password/token)
JIRA_AUTH=bearer
JIRA_USER=your-username
JIRA_PAT=REPLACE_WITH_YOUR_PERSONAL_ACCESS_TOKEN
# JIRA_PASSWORD=only-if-you-use-basic-with-a-password
# JIRA_CA_BUNDLE=~/certs/internal-ca.pem
